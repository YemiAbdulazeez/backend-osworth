NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Docker MySQL (docker compose up -d):
DATABASE_URL=mysql://osworth:osworth@127.0.0.1:3306/osworth

# Managed MySQL (Aiven / Azure / etc.) — use the live Service URI from the provider console:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

JWT_ACCESS_SECRET=local-dev-access-secret-change
JWT_REFRESH_SECRET=local-dev-refresh-secret-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RESEND_API_KEY=
EMAIL_FROM="Osworth <noreply@example.com>"
OPS_EMAIL=ops@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_SUPER_ADMIN_EMAIL=admin@osworth.local
SEED_SUPER_ADMIN_PASSWORD=osworth2027
SEED_SUPER_ADMIN_NAME=Osworth Super Admin

# Render production notes:
# - APP_URL / CORS_ORIGINS = your Vercel frontend origin(s)
# - COOKIE_SECURE=true and COOKIE_SAMESITE=none for cross-site auth cookies
# - DATABASE_URL must resolve in DNS (copy a fresh URI if you recreate the DB)
# - Boot script: migrate → seed → node dist/index.js
