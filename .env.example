NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=mysql://osworth:osworth@127.0.0.1:3306/osworth

JWT_ACCESS_SECRET=local-dev-access-secret-change
JWT_REFRESH_SECRET=local-dev-refresh-secret-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RESEND_API_KEY=
EMAIL_FROM="Osworth <noreply@example.com>"
OPS_EMAIL=ops@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_SUPER_ADMIN_EMAIL=admin@osworth.local
SEED_SUPER_ADMIN_PASSWORD=osworth2027
SEED_SUPER_ADMIN_NAME=Osworth Super Admin

# Render production notes:
# - Set APP_URL to the Azure Static Web Apps origin (https://....azurestaticapps.net)
# - Set CORS_ORIGINS to that same origin (comma-separated if you have preview + production)
# - COOKIE_SECURE=true and COOKIE_SAMESITE=none are required for cross-site auth cookies
# - Point DATABASE_URL at Azure Database for MySQL or any managed MySQL 8 host
# - After first deploy run: npm run db:migrate && npm run db:seed (or use scripts/render-start.sh)
